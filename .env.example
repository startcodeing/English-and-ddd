# English Learning Platform - Environment Variables Template
# 请复制此文件为 .env 并填写所有必要的配置项

# ============================================================
# MySQL数据库配置
# ============================================================
# MySQL root密码（强烈建议在生产环境中修改）
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# MySQL数据库名称
MYSQL_DATABASE=english_learning_platform

# MySQL应用用户名
MYSQL_USERNAME=english_user

# MySQL应用用户密码
MYSQL_PASSWORD=your_secure_application_password_here

# MySQL主机地址（Docker内部服务使用mysql）
MYSQL_HOST=mysql

# MySQL端口
MYSQL_PORT=3306

# MySQL字符集
MYSQL_CHARSET=utf8mb4

# MySQL排序规则
MYSQL_COLLATION=utf8mb4_unicode_ci

# ============================================================
# Spring Boot后端配置
# ============================================================
# Spring配置文件
SPRING_PROFILES_ACTIVE=prod,mysql-event-handler

# 应用名称
SPRING_APPLICATION_NAME=english-learning-platform

# 服务器端口
SERVER_PORT=8080

# 应用上下文路径
SERVER_CONTEXT_PATH=/

# JVM内存配置（根据服务器内存调整）
JVM_XMS=512m
JVM_XMX=1024m

# JVM GC配置
JVM_GC_LOG_LEVEL=INFO

# ============================================================
# 日志配置
# ============================================================
# 日志级别（TRACE, DEBUG, INFO, WARN, ERROR）
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING_FRAMEWORK=INFO
LOG_LEVEL_SPRING_WEB=INFO
LOG_LEVEL_SPRING_DATA=INFO
LOG_LEVEL_SPRING_JPA=INFO
LOG_LEVEL_SPRING_BOOT=INFO
LOG_LEVEL_SPRING_SECURITY=INFO
LOG_LEVEL_SPRING_HIBERNATE=ERROR
LOG_LEVEL_SPRING_HIBERNATE_TYPE=DEBUG
LOG_LEVEL_SPRING_HIBERNATE_SQL=DEBUG
LOG_LEVEL_SPRING_HIBERNATE_TRANSACTION=DEBUG
LOG_LEVEL_SPRING_HIBERNATE_JDBC=DEBUG

# ============================================================
# 文件存储配置
# ============================================================
# 文件存储类型（local, oss_s3, oss_minio, oss_azure, oss_gcp）
FILE_STORAGE_TYPE=local

# 本地文件存储路径
FILE_STORAGE_ROOT=./boot/uploads

# 上传文件目录
FILE_UPLOAD_DIR=./boot/uploads

# 文件访问URL路径
FILE_ACCESS_URL=/files

# 最大文件大小（字节）= 10MB
FILE_MAX_FILE_SIZE=10485760

# 最大请求大小（字节）= 10MB
FILE_MAX_REQUEST_SIZE=10485760

# 文件大小阈值（字节）= 2MB
FILE_SIZE_THRESHOLD=2097152

# ============================================================
# OSS配置（可选，如果使用云存储）
# ============================================================
# AWS S3配置
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=your_s3_bucket_name_here
AWS_REGION=us-east-1

# MinIO配置（S3兼容）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=english-learning-platform

# Azure Blob配置
AZURE_STORAGE_ACCOUNT=your_azure_storage_account_here
AZURE_STORAGE_KEY=your_azure_storage_key_here
AZURE_CONTAINER=your_azure_container_name_here

# GCP Storage配置
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_CREDENTIALS_PATH=/path/to/credentials.json
GCP_BUCKET_NAME=your_gcp_bucket_name_here

# ============================================================
# Axon事件框架配置
# ============================================================
# Axon服务器启用（true/false）
AXON_AXONSERVER_ENABLED=false

# Axon序列化
AXON_SERIALIZER_GENERAL=xstream
AXON_SERIALIZER_MESSAGES=jackson
AXON_SERIALIZER_EVENTS=jackson

# 事件处理模式
AXON_EVENT_PROCESSING_MODE=tracking_processing_event_processor

# ============================================================
# Prometheus监控配置
# ============================================================
# Prometheus启用（true/false）
PROMETHEUS_ENABLED=false

# Prometheus导出端点
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# 指标标签
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# ============================================================
# 前端配置
# ============================================================
# 前端构建URL（后端API地址）
VITE_API_BASE_URL=http://localhost:8080

# 前端应用标题
VITE_APP_TITLE=English Learning Platform

# 前端应用描述
VITE_APP_DESCRIPTION=An English learning platform with DDD architecture

# 前端主题
VITE_APP_THEME=light

# 前端语言
VITE_APP_LANGUAGE=zh-CN

# ============================================================
# Docker配置
# ============================================================
# Docker容器内存限制（MB）
DOCKER_BACKEND_MEMORY_LIMIT=2048
DOCKER_MYSQL_MEMORY_LIMIT=1024
DOCKER_FRONTEND_MEMORY_LIMIT=512
DOCKER_NGINX_MEMORY_LIMIT=256

# Docker容器CPU限制
DOCKER_BACKEND_CPU_LIMIT=2.0
DOCKER_MYSQL_CPU_LIMIT=1.0
DOCKER_FRONTEND_CPU_LIMIT=0.5
DOCKER_NGINX_CPU_LIMIT=0.5

# ============================================================
# 开发/生产环境配置
# ============================================================
# 环境类型（development, staging, production）
ENV=production

# 调试模式（开发环境：true，生产环境：false）
DEBUG=false

# 显示SQL（开发环境：true，生产环境：false）
SPRING_JPA_SHOW_SQL=false

# 格式化SQL
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# 显示JDBC SQL
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_LOG_SQL=false

# ============================================================
# 时区配置
# ============================================================
# 应用时区
SERVER_TIMEZONE=Asia/Shanghai

# MySQL时区
MYSQL_TIMEZONE=Asia/Shanghai

# ============================================================
# 安全配置
# ============================================================
# 密钥加密盐（至少32个字符）
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters

# JWT令牌有效期（分钟）
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60

# JWT刷新令牌有效期（天）
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:8080,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_EXPOSE_HEADERS=Content-Length,X-Process-Time,X-Request-ID,X-Total-Count
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================================
# 性能配置
# ============================================================
# HikariCP连接池配置
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_CONNECTION_TEST_QUERY=SELECT 1

# JPA/Hibernate配置
SPRING_JPA_HIBERNATE_STATEMENT_BATCH_SIZE=50
SPRING_JPA_HIBERNATE_JDBC_FETCH_SIZE=50
SPRING_JPA_HIBERNATE_JDBC_BATCH_SIZE=50
SPRING_JPA_HIBERNATE_CACHE_USE_SECOND_LEVEL_CACHE=true
SPRING_JPA_HIBERNATE_CACHE_REGION_FACTORY_CLASS=org.hibernate.cache.jcache.JCacheRegionFactory
SPRING_JPA_HIBERNATE_JPA_COMPLIANCE=validate

# ============================================================
# 邮件配置（可选）
# ============================================================
# SMTP服务器配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@english-learning-platform.com

# 启用SMTP
MAIL_ENABLED=false

# ============================================================
# 第三方服务配置（可选）
# ============================================================
# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic API配置
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# ============================================================
# 备份配置
# ============================================================
# 自动备份启用
BACKUP_ENABLED=false

# 备份目录
BACKUP_DIR=./backups

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# 备份时间（cron表达式）= 每天凌晨2点
BACKUP_SCHEDULE=0 2 * * *
