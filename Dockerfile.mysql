# MySQL 8.0 Dockerfile for English Learning Platform

FROM mysql:8.0

# Set environment variables
ENV MYSQL_ROOT_PASSWORD=root_password
ENV MYSQL_DATABASE=english_learning_platform
ENV MYSQL_USER=english_user
ENV MYSQL_PASSWORD=english_password

# Add health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD mysqladmin ping -h localhost -u root -p${MYSQL_ROOT_PASSWORD} || exit 1

# Expose MySQL port
EXPOSE 3306

# Set up data volume
VOLUME /var/lib/mysql

# Set configuration
CMD ["--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci", "--default-authentication-plugin=mysql_native_password"]
