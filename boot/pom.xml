<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.englishlearning</groupId>
        <artifactId>english-learning-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>boot</artifactId>

    <dependencies>
        <!-- 基础模块 -->
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>common</artifactId>
        </dependency>
        
        <!-- 领域模块 -->
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>domain-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>domain-vocabulary</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>domain-activity</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>domain-practice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>domain-user</artifactId>
        </dependency>

        <!-- 应用模块 -->
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>application-vocabulary</artifactId>
        </dependency>

        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>application-content</artifactId>
        </dependency>

        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>application-practice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>application-user</artifactId>
        </dependency>

        <!-- 基础设施模块 -->
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>infrastructure-db</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>infrastructure-event</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>infrastructure-activity</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>infrastructure-auth</artifactId>
        </dependency>

        <!-- 接口模块 -->
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>interfaces-vocabulary</artifactId>
        </dependency>

        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>interfaces-content</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>interfaces-activity</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>interfaces-practice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.englishlearning</groupId>
            <artifactId>interfaces-user</artifactId>
        </dependency>

        <!-- Spring Boot 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- This is needed when using Lombok 1.18.16 and above -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
 